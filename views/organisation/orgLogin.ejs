<% layout("layouts/boilerplate.ejs") %>
<link rel="stylesheet" href="/css/orgLogin.css" />
<div class="org-login-container">
  <div class="org-login-card">
    <p class="org-access-only-msg">Organisation staff only</p>
    <h3>Organisation login</h3>
    <p class="org-login-second-msg">
      For BioBridge staff managing donors, results and hospital requests.
    </p>
    <form method="post" action="/org/orglogin">
      <div class="org_input">
        <label for="staffEmail">Organisation ID</label>
        <input id="orgId" name="username" type="text" placeholder="ORG-003" />
      </div>
      <div class="org_input">
        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          placeholder="Password"
        />
      </div>
      <button id="button">Log in</button>
    </form>
  </div>
  <!--Org login card-->
</div>
<!--Org login container -->
