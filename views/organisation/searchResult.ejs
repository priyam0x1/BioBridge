<% layout("layouts/boilerplate.ejs") %>

<link rel="stylesheet" href="/css/orgSearchResult.css" />

<div class="search_result_container">

    <div class="back_to_orgDashboard">
        <form method="GET" action="/org/orgdashboard">
            <button class="back_to_orgDashboard_btn">
                &#8592; Back to dashboard
            </button>
        </form>
    </div>

    <% if(allDonor.length === 0){ %>

        <h1>No results found for "<%= search %>"</h1>

    <% } else { %>

        <h1>Search Result</h1>

        <div class="column_name">
            <p>Donor Name</p>
            <p>Donor ID</p>
            <p>HLA Type</p>
            <p>Blood Group</p>
            <p>Test Date</p>
            <p>View Donor</p>
        </div>

        <% for(let donor of allDonor){ %>

        <div class="donor_detail">

            <div><%= donor.name %></div>

            <div><%= donor.donor_id.slice(0,5) %></div>

            <div><%= donor.HLA_type %></div>

            <div><%= donor.blood_grp %></div>

            <div><%= donor.test_date.toLocaleDateString() %></div>

            <form method="GET" action="/org/orgdashboard/<%= donor._id %>">
                <button class="view_btn">
                    View Donor
                </button>
            </form>

        </div>

        <% } %>

    <% } %>

</div>
