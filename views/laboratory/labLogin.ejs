<% layout("layouts/boilerplate.ejs") %>
<link rel="stylesheet" href="/css/labLogin.css" />
<div class="lab-login-container">
  <div class="lab-login-card">
    <p class="lab-access-only-msg">Laboratory access only</p>
    <h3>Laboratory login</h3>
    <p class="lab-login-second-msg">
      Restricted to partner laboratories processing BioBridge samples.
    </p>
    <form method="post" action="/lab/lablogin">
      <div class="lab_input">
        <label for="labID">Laboratory ID</label>
        <input
          id="labID"
          type="text"
          name="username"
          placeholder="LAB-0032"
          required
        />
      </div>
      <div class="lab_input">
        <label for="password">Password</label>
        <input
          id="password"
          type="password"
          name="password"
          placeholder="Password"
          required
        />
      </div>
      <button id="button" type="submit">Log in</button>
    </form>
    <p class="lab-login-last-msg">
      Access is issued by BioBridge after laboratory accreditation is verified.
    </p>
  </div>
  <!--Lab login card-->
</div>
<!--lab login container -->
